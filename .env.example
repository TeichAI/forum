# Required in production for Clerk user and public role-badge synchronization.
# It may remain blank for normal local development.
CLERK_WEBHOOK_SECRET=""
# Optional: omit or leave blank to disable image uploads.
UPLOADTHING_TOKEN=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
