DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teich_forum"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
# Must match Clerk Dashboard > Access mode: public, restricted, or waitlist.
# This is bundled at build time; rebuild the app after changing it.
NEXT_PUBLIC_CLERK_ACCESS_MODE="public"
# Required in production for Clerk user and public role-badge synchronization.
# It may remain blank for normal local development.
CLERK_WEBHOOK_SECRET=""
# Optional: omit or leave blank to disable image uploads.
UPLOADTHING_TOKEN=""
# Required by POST /api/maintenance/uploads. Generate a distinct random bearer secret.
CRON_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production requires HTTPS, live Clerk keys, the webhook secret, and an explicit access mode.
# Required in production. Generate a random value of at least 32 characters; it HMAC-hashes rate-limit subjects.
RATE_LIMIT_HASH_SECRET="replace-with-at-least-32-random-characters"
# Emergency kill switch. Omit or set to true for normal operation.
RATE_LIMITING_ENABLED="true"
