generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ContentStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum NotificationType {
  REPLY
  MENTION
  UPVOTE
  FOLLOW
  MESSAGE
  MODERATION
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReportTargetType {
  THREAD
  REPLY
  USER
  MESSAGE
  SPACE
  TAG
  SETTINGS
  REPORT
}

enum ModerationActionType {
  HIDE
  RESTORE
  LOCK
  UNLOCK
  SUSPEND
  UNSUSPEND
  RESOLVE_REPORT
  DISMISS_REPORT
  REOPEN_REPORT
  CLAIM_REPORT
  UNCLAIM_REPORT
  SET_PRIORITY
  PIN
  UNPIN
  ADD_NOTE
  CREATE_SPACE
  UPDATE_SPACE
  ARCHIVE_SPACE
  RESTORE_SPACE
  REORDER_SPACE
  RENAME_TAG
  MERGE_TAG
  UPDATE_MODERATION_SETTINGS
}

enum AttachmentContext {
  THREAD
  REPLY
  MESSAGE
  DRAFT
}

enum SpacePostingPolicy {
  OPEN
  ANNOUNCEMENTS
  ADMIN_ONLY
}

model User {
  id               String     @id @default(cuid())
  clerkId          String     @unique
  email            String?
  username         String     @unique
  displayName      String
  bio              String     @default("")
  imageUrl         String?
  role             UserRole   @default(MEMBER)
  status           UserStatus @default(ACTIVE)
  suspendedUntil   DateTime?
  suspensionReason String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  threads             Thread[]
  replies             Reply[]
  threadVotes         ThreadVote[]
  replyVotes          ReplyVote[]
  bookmarks           Bookmark[]
  following           Follow[]           @relation("Following")
  followers           Follow[]           @relation("Followers")
  conversationsAsOne  Conversation[]     @relation("ConversationMemberOne")
  conversationsAsTwo  Conversation[]     @relation("ConversationMemberTwo")
  messages            Message[]
  notifications       Notification[]     @relation("NotificationRecipient")
  notificationActions Notification[]     @relation("NotificationActor")
  reports             Report[]           @relation("ReportReporter")
  assignedCases       ModerationCase[]   @relation("CaseAssignee")
  moderationActions   ModerationAction[] @relation("Moderator")
  moderationReceived  ModerationAction[] @relation("ModeratedUser")
  authoredStaffNotes  StaffNote[]        @relation("StaffNoteAuthor")
  receivedStaffNotes  StaffNote[]        @relation("StaffNoteUser")
  blocksInitiated     Block[]            @relation("Blocker")
  blocksReceived      Block[]            @relation("Blocked")
  attachments         Attachment[]

  @@index([role, status])
  @@index([createdAt])
}

model Category {
  id            String             @id @default(cuid())
  name          String             @unique
  slug          String             @unique
  description   String
  color         String             @default("#0f766e")
  icon          String             @default("messages-square")
  position      Int                @default(0)
  postingPolicy SpacePostingPolicy @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archivedAt    DateTime?
  threads       Thread[]

  @@index([position])
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  createdAt DateTime    @default(now())
  threads   ThreadTag[]
  aliases   TagAlias[]
}

model TagAlias {
  slug      String   @id
  tagId     String
  createdAt DateTime @default(now())
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@index([tagId])
}

model Thread {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  body       String
  status     ContentStatus @default(PUBLISHED)
  isPinned   Boolean       @default(false)
  isLocked   Boolean       @default(false)
  viewCount  Int           @default(0)
  authorId   String
  categoryId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  editedAt   DateTime?
  bumpedAt   DateTime      @default(now())
  deletedAt  DateTime?

  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags          ThreadTag[]
  replies       Reply[]
  votes         ThreadVote[]
  bookmarks     Bookmark[]
  notifications Notification[]

  @@index([status, isPinned, bumpedAt(sort: Desc)])
  @@index([categoryId, status, bumpedAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model ThreadTag {
  threadId String
  tagId    String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@index([tagId])
}

model Reply {
  id        String        @id @default(cuid())
  body      String
  status    ContentStatus @default(PUBLISHED)
  threadId  String
  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  thread        Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  votes         ReplyVote[]
  notifications Notification[]

  @@index([threadId, status, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}

model ThreadVote {
  userId    String
  threadId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@index([threadId])
}

model ReplyVote {
  userId    String
  replyId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([userId, replyId])
  @@index([replyId])
}

model Bookmark {
  userId    String
  threadId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@id([userId, threadId])
  @@index([userId, createdAt(sort: Desc)])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Conversation {
  id            String         @id @default(cuid())
  pairKey       String         @unique
  memberOneId   String
  memberTwoId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastMessageAt DateTime       @default(now())
  memberOne     User           @relation("ConversationMemberOne", fields: [memberOneId], references: [id], onDelete: Cascade)
  memberTwo     User           @relation("ConversationMemberTwo", fields: [memberTwoId], references: [id], onDelete: Cascade)
  messages      Message[]
  notifications Notification[]

  @@index([memberOneId, lastMessageAt(sort: Desc)])
  @@index([memberTwoId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String         @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime       @default(now())
  editedAt       DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Restrict)
  notifications  Notification[]

  @@index([conversationId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}

model Notification {
  id                 String            @id @default(cuid())
  type               NotificationType
  recipientId        String
  actorId            String?
  threadId           String?
  replyId            String?
  conversationId     String?
  messageId          String?
  moderationActionId String?
  readAt             DateTime?
  createdAt          DateTime          @default(now())
  recipient          User              @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor              User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  thread             Thread?           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reply              Reply?            @relation(fields: [replyId], references: [id], onDelete: Cascade)
  conversation       Conversation?     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message            Message?          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  moderationAction   ModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt(sort: Desc)])
}

model Report {
  id         String           @id @default(cuid())
  caseId     String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String           @default("")
  reporterId String
  createdAt  DateTime         @default(now())
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  case       ModerationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([caseId, createdAt])
  @@index([targetType, targetId])
}

model ModerationCase {
  id           String             @id @default(cuid())
  targetType   ReportTargetType
  targetId     String
  status       ReportStatus       @default(OPEN)
  priority     ReportPriority     @default(NORMAL)
  assignedToId String?
  resolution   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  closedAt     DateTime?
  assignedTo   User?              @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  reports      Report[]
  notes        StaffNote[]
  actions      ModerationAction[]

  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
  @@index([targetType, targetId, status])
}

model StaffNote {
  id        String          @id @default(cuid())
  body      String
  authorId  String
  caseId    String?
  userId    String?
  createdAt DateTime        @default(now())
  author    User            @relation("StaffNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  case      ModerationCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User?           @relation("StaffNoteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@index([userId, createdAt])
}

model ModerationSettings {
  id                      String   @id @default("default")
  reportReasons           String[] @default(["Spam", "Harassment", "Unsafe content", "Off topic", "Other"])
  suspensionDurationsDays Int[]    @default([1, 3, 7, 30, 90])
  actionReasons           String[] @default(["Spam", "Harassment", "Unsafe content", "Off topic", "Repeated violations", "Other"])
  updatedAt               DateTime @updatedAt
}

model ModerationAction {
  id            String               @id @default(cuid())
  type          ModerationActionType
  moderatorId   String
  userId        String?
  caseId        String?
  targetType    ReportTargetType
  targetId      String
  reason        String
  metadata      Json?
  createdAt     DateTime             @default(now())
  moderator     User                 @relation("Moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  user          User?                @relation("ModeratedUser", fields: [userId], references: [id], onDelete: SetNull)
  case          ModerationCase?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([moderatorId, createdAt(sort: Desc)])
  @@index([caseId, createdAt(sort: Desc)])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Attachment {
  id        String            @id @default(cuid())
  key       String            @unique
  url       String
  name      String
  size      Int
  context   AttachmentContext @default(DRAFT)
  targetId  String?
  userId    String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([context, targetId])
}

model RateLimitBucket {
  subject      String
  scope        String
  tokens       Float
  lastRefillAt DateTime
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@id([subject, scope])
  @@index([expiresAt])
}
